<% content_for :title, "New password" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-5 col-lg-4">
    <div class="card shadow-sm mt-3">
      <div class="card-body p-4">
        <h1 class="h3 mb-3">Update your password</h1>
        <%= form_with url: password_path(params[:token]), method: :put do |form| %>
          <div class="mb-3">
            <%= form.label :password, "New password", class: "form-label" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "form-control form-control-lg" %>
          </div>
          <div class="mb-3">
            <%= form.label :password_confirmation, "Repeat password", class: "form-label" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-control form-control-lg" %>
          </div>
          <%= form.submit "Save", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
