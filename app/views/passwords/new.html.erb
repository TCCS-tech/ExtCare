<% content_for :title, "Reset password" %>

<div class="row justify-content-center">
  <div class="col-12 auth-column">
    <div class="card shadow-sm auth-card">
      <%= render "shared/auth_brand" %>
      <div class="card-body p-4">
        <h1 class="h3 mb-3">Forgot your password?</h1>
        <div class="alert alert-warning" role="alert">
          Email is not configured. Please contact your administrator to reset your password.
        </div>
        <p class="mt-3 mb-0"><%= link_to "Back to sign in", new_session_path %></p>
      </div>
    </div>
  </div>
</div>
