<%# locals: (route:, day:, grade:, query:, autofocus: false) %>
<div class="day-toolbar mb-3" data-controller="roster-filter">
  <div class="attendance-switch mb-3" role="navigation" aria-label="Attendance pages">
    <%= link_to "Check in", checkins_path(day: day, grade: grade.presence, q: query.presence),
          class: "attendance-switch-link", aria: { current: ("page" if route == :checkins_path) } %>
    <%= link_to "Check out", checkouts_path(day: day, grade: grade.presence, q: query.presence),
          class: "attendance-switch-link", aria: { current: ("page" if route == :checkouts_path) } %>
  </div>
  <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <%= link_to public_send(route, day: day - 1, grade: grade.presence, q: query.presence), class: "btn btn-outline-secondary btn-lg px-3", aria: { label: "Previous day" } do %>
      <span aria-hidden="true">&lsaquo;</span>
    <% end %>
    <div class="text-center">
      <div class="fs-5 fw-semibold"><%= l(day, format: :long_day) %></div>
      <% if route == :checkins_path %>
        <% if day == Date.current %>
          <div class="small d-flex align-items-center justify-content-center gap-2 mt-1" data-checkin-time-target="currentTimeControl">
            <span aria-live="off" data-checkin-time-target="clock"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Adjust check-in time" title="Adjust check-in time" data-action="checkin-time#showAdjustment">
              <span aria-hidden="true">&#x23F1;</span>
            </button>
            <input type="time" class="form-control form-control-sm" value="15:00" required aria-label="Check-in time" data-checkin-time-target="field" hidden>
            <button type="button" class="btn btn-sm btn-link p-0" aria-label="Use current time" title="Use current time" data-checkin-time-target="resetButton" data-action="checkin-time#useCurrentTime" hidden>
              <span aria-hidden="true">&#x21BA;</span>
            </button>
          </div>
        <% else %>
          <label class="small d-flex align-items-center justify-content-center gap-2 mt-1">
            <span>Check-in time</span>
            <input type="time" class="form-control form-control-sm" value="15:00" required aria-label="Check-in time" data-checkin-time-target="field">
          </label>
        <% end %>
      <% elsif route == :checkouts_path %>
        <% if day == Date.current %>
          <div class="small d-flex align-items-center justify-content-center gap-2 mt-1" data-checkin-time-target="currentTimeControl">
            <span aria-live="off" data-checkin-time-target="clock"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Adjust check-out time" title="Adjust check-out time" data-action="checkin-time#showAdjustment">
              <span aria-hidden="true">&#x23F1;</span>
            </button>
            <input type="time" class="form-control form-control-sm" value="15:00" required aria-label="Check-out time" data-checkin-time-target="field" hidden>
            <button type="button" class="btn btn-sm btn-link p-0" aria-label="Use current time" title="Use current time" data-checkin-time-target="resetButton" data-action="checkin-time#useCurrentTime" hidden>
              <span aria-hidden="true">&#x21BA;</span>
            </button>
          </div>
        <% else %>
          <label class="small d-flex align-items-center justify-content-center gap-2 mt-1">
            <span>Check-out time</span>
            <input type="time" class="form-control form-control-sm" value="15:00" required aria-label="Check-out time" data-checkin-time-target="field">
          </label>
        <% end %>
      <% end %>
      <% unless day == Date.current %>
        <%= link_to "Back to today", public_send(route, grade: grade.presence, q: query.presence), class: "small" %>
      <% end %>
    </div>
    <% if day < Date.current %>
      <%= link_to public_send(route, day: day + 1, grade: grade.presence, q: query.presence), class: "btn btn-outline-secondary btn-lg px-3", aria: { label: "Next day" } do %>
        <span aria-hidden="true">&rsaquo;</span>
      <% end %>
    <% else %>
      <%# Today is the last day that can be viewed. Keep a disabled button so the row keeps its shape and the arrow is visibly spent. %>
      <button type="button" class="btn btn-outline-secondary btn-lg px-3" disabled aria-label="Next day">
        <span aria-hidden="true">&rsaquo;</span>
      </button>
    <% end %>
  </div>

  <%= form_with url: public_send(route), method: :get, data: { roster_filter_target: "form", turbo_action: "advance", turbo_frame: "#{route.to_s.delete_suffix("_path")}-results" } do %>
    <%= hidden_field_tag :day, day %>
    <%= hidden_field_tag :grade, grade, data: { roster_filter_target: "grade" } %>
    <label class="visually-hidden" for="<%= route %>_query">Find a student</label>
    <div class="input-group mb-3">
      <%= text_field_tag :q, query, id: "#{route}_query", class: "form-control form-control-lg", placeholder: "Type any part of a name", autocomplete: "off", enterkeyhint: "search", data: { roster_filter_target: "query", action: "input->roster-filter#submit keydown.esc->roster-filter#clearOnEscape", autofocus: (autofocus ? "true" : nil) } %>
      <button type="button" class="btn btn-outline-secondary" aria-label="Clear search" title="Clear search" data-roster-filter-target="clearButton" data-action="roster-filter#clearQuery" <%= "hidden" if query.blank? %>>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="d-flex flex-wrap gap-2" role="group" aria-label="Grade">
      <%= button_tag "All", type: "button", aria: { pressed: grade.blank? }, class: "btn #{grade.blank? ? "btn-primary" : "btn-outline-primary"}", data: { action: "roster-filter#submitGrade", roster_filter_grade_param: "all" } %>
      <% Student.grade_options.each do |label, number| %>
        <% active = grade.to_s == number.to_s %>
        <%= button_tag label, type: "button", aria: { pressed: active }, class: "btn #{active ? "btn-primary" : "btn-outline-primary"}", data: { action: "roster-filter#submitGrade", roster_filter_grade_param: number } %>
      <% end %>
    </div>
  <% end %>
</div>
