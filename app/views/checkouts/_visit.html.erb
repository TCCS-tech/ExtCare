<%# locals: (visit:, day:, grade:, query:) %>
<%= tag.div id: dom_id(visit, :checkout), class: "list-group-item attendance-row", data: { attendance_lists_target: "item", first_name: visit.student.first_name.downcase, last_name: visit.student.last_name.downcase, student_id: visit.student.id, completed: visit.checkout.present?, attendance_status: "Checked out" } do %>
  <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="student-name fs-5 fw-semibold"><%= visit.student.full_name %></span>
        <span class="badge text-bg-light">Grade <%= visit.student.grade_label %></span>
        <% if visit.student.hidden? %>
          <span class="badge text-bg-secondary">Removed</span>
        <% end %>
        <%= render "shared/student_flags", student: visit.student %>
      </div>
      <div class="small text-body-secondary mt-1">In at <%= clock(visit.checkin) %></div>
    </div>
    <div class="d-flex align-items-center justify-content-end gap-2 checkout-actions">
      <% if visit.checkout %>
        <span class="fs-4 fw-semibold text-nowrap"><%= clock(visit.checkout) %></span>
      <% else %>
        <%= button_to "Check out", checkouts_path,
              params: { attendance_id: visit.id, day: day, grade: grade, q: query, checkout_time: (day < Date.current ? "15:00" : nil) },
              class: "btn btn-primary btn-lg checkout-submit-button",
              form: { class: "m-0" } %>
        <button type="button" class="btn btn-outline-secondary btn-lg pickup-details-button" data-bs-toggle="modal" data-bs-target="#pickup-modal-<%= visit.id %>" aria-label="Add pickup name for <%= visit.student.full_name %>" title="Add pickup name">
          <span aria-hidden="true">…</span>
        </button>
      <% end %>
    </div>
  </div>
  <% if visit.open? %>
    <div class="modal fade" id="pickup-modal-<%= visit.id %>" tabindex="-1" aria-labelledby="pickup-modal-title-<%= visit.id %>" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <%= form_with model: visit, url: checkout_path(visit), method: :patch, data: { turbo: false } do |form| %>
            <%= hidden_field_tag :day, day %>
            <%= hidden_field_tag :grade, grade %>
            <%= hidden_field_tag :q, query %>
            <div class="modal-header">
              <h2 class="modal-title fs-5" id="pickup-modal-title-<%= visit.id %>">Who is picking up <%= visit.student.first_name %>?</h2>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <% if visit.student.guardians.any? %>
                <div class="mb-3">
                  <div class="form-label mb-1">Guardians</div>
                  <div><%= visit.student.guardian_list %></div>
                </div>
              <% end %>
              <% if visit.student.notes.present? %>
                <div class="mb-3">
                  <div class="form-label mb-1">Student notes</div>
                  <%= simple_format(visit.student.notes, class: "mb-0") %>
                </div>
              <% end %>
              <%= form.label :pickup_notes, "Pickup Notes", class: "form-label" %>
              <%= form.text_field :pickup_notes, class: "form-control", autocomplete: "name", placeholder: "Enter a name or a note", maxlength: 255 %>
              <div class="form-text">Optional. You can still check out without adding a name.</div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <%= form.submit "Save name", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <% if visit.pickup_notes.present? %>
    <div class="small text-body-secondary mt-2">Pickup notes: <%= visit.pickup_notes %></div>
  <% end %>
<% end %>
