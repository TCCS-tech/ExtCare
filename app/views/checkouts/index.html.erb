<% content_for :title, "Check out" %>
<%= render "shared/page_heading", title: "Check out", description: "Ready to head home? Record a student’s pickup.", eyebrow: "STUDENT ATTENDANCE" %>

<%= render "shared/day_toolbar", route: :checkouts_path, day: @day, grade: @grade, query: @q, autofocus: true %>

<% if @other_open_days.any? %>
  <div class="alert alert-warning">
    Open check-ins on other days:
    <% @other_open_days.each do |other_day| %>
      <%= link_to l(other_day, format: :long_day), checkouts_path(day: other_day, grade: @grade, q: @q.presence), class: "alert-link d-block" %>
    <% end %>
  </div>
<% end %>

<div data-controller="attendance-lists">
  <% [["ready", "Ready to check out", @ready_visits, "No students are waiting to check out."],
      ["completed", "Already checked out", @checked_out_visits, "No students checked out yet."]].each do |key, title, visits, empty_message| %>
    <section class="attendance-section" aria-labelledby="checkout-<%= key %>-heading">
      <h2 id="checkout-<%= key %>-heading" class="attendance-heading"><%= title %></h2>
      <div id="checkout-<%= key %>" class="list-group shadow-sm attendance-list" data-attendance-lists-target="<%= key %>">
        <% visits.each do |visit| %>
          <%= render "visit", visit: visit, day: @day, grade: @grade, query: @q %>
        <% end %>
      </div>
      <p class="empty-state attendance-empty"><%= empty_message %></p>
    </section>
  <% end %>
  <p class="visually-hidden" role="status" data-attendance-lists-target="status"></p>
</div>
