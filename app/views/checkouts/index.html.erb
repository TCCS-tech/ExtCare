<% content_for :title, "Check out" %>
<h1 class="h3 mb-3">Check out</h1>

<%= render "shared/day_toolbar", route: :checkouts_path, day: @day, grade: @grade, query: @q, autofocus: true %>

<% if @other_open_days.any? %>
  <div class="alert alert-warning">
    Open check-ins on other days:
    <% @other_open_days.each do |other_day| %>
      <%= link_to l(other_day, format: :long_day), checkouts_path(day: other_day, grade: @grade, q: @q.presence), class: "alert-link d-block" %>
    <% end %>
  </div>
<% end %>

<% if @visits.empty? %>
  <p class="text-body-secondary">No students are waiting to check out.</p>
<% else %>
  <div class="list-group shadow-sm">
    <% @visits.each do |visit| %>
      <%= render "visit", visit: visit, day: @day, grade: @grade, query: @q %>
    <% end %>
  </div>
<% end %>
