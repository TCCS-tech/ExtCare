<% content_for :title, "Sign in" %>

<div class="row justify-content-center">
  <div class="col-12 auth-column">
    <div class="card shadow-sm auth-card">
      <%= render "shared/auth_brand" %>
      <div class="card-body p-4">
        <h1 class="h3 mb-3">Sign in</h1>
        <%= form_with url: session_path do |form| %>
          <div class="mb-3">
            <%= form.label :email, "Email", class: "form-label" %>
            <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", class: "form-control form-control-lg", value: params[:email] || "admin@example.com" %>
          </div>
          <div class="mb-3">
            <%= form.label :password, "Password (John's email address)", class: "form-label" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-control form-control-lg" %>
          </div>
          <%= form.submit "Sign in", class: "btn btn-primary btn-lg w-100" %>
        <% end %>
        <p class="mt-3 mb-0"><%= link_to "Forgot password?", new_password_path %></p>
      </div>
    </div>
  </div>
</div>
