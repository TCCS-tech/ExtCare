<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th aria-sort="<%= @sort_direction == "desc" ? "descending" : "ascending" %>"><%= link_to admin_billing_records_path(day: @day, month: @month, grade: @grade, q: @query.presence, sort: @sort_direction == "desc" ? "asc" : "desc"), class: "link-body-emphasis text-decoration-none", aria: { label: "Sort by date #{@sort_direction == "desc" ? "ascending" : "descending"}" } do %>Date <span aria-hidden="true"><%= @sort_direction == "desc" ? "↓" : "↑" %></span><% end %></th><th>Student</th><th>Blackbaud ID</th><th>Visits</th><th>AM</th><th>PM</th><th>Late fee</th><th>Total</th></tr></thead><tbody>
  <% @records.each do |record| %><tr><td><%= record.day %></td><td><%= record.student.full_name %><% if record.student.flag_labels.any? %><div class="d-flex flex-wrap gap-1 mt-1"><% record.student.flag_labels.each do |label| %><span class="badge text-bg-secondary"><%= label %></span><% end %></div><% end %></td><td><%= record.student.blackbaud_id %></td><td><%= record.notes.presence || "—" %></td><td><%= number_to_currency(record.am_cents / 100.0) %></td><td><%= number_to_currency(record.pm_cents / 100.0) %></td><td><%= number_to_currency(record.late_fee_cents / 100.0) %></td><td class="fw-semibold"><%= number_to_currency(record.total_cents / 100.0) %></td></tr><% end %>
  <% if @records.empty? %><tr><td colspan="8" class="text-body-secondary">No billing records match these filters.</td></tr><% end %>
</tbody></table></div>
<div class="small text-body-secondary text-end"><%= @shown_count %> of <%= @total_count %> records shown</div>
