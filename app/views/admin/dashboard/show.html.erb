<% content_for :title, "Admin" %>
<%= render "shared/page_heading", title: "Admin", description: "Manage students and keep track of each school day.", eyebrow: "SCHOOL OFFICE" %>

<div class="row g-3">
  <div class="col-12 col-md-6">
    <%= link_to admin_checkins_path, class: "card card-body shadow-sm text-decoration-none h-100" do %>
      <h2 class="h4">Check-ins</h2>
      <p class="text-body-secondary mb-0">Review daily check-in and check-out records.</p>
    <% end %>
  </div>
  <div class="col-12 col-md-6">
    <%= link_to admin_students_path, class: "card card-body shadow-sm text-decoration-none h-100" do %>
      <h2 class="h4">Students</h2>
      <p class="text-body-secondary mb-0">Find and manage student records.</p>
    <% end %>
  </div>
  <% if Rails.env.development? %>
    <div class="col-12 col-md-6">
      <div class="card card-body shadow-sm h-100">
        <h2 class="h4">Dev</h2>
        <p class="text-body-secondary">Development data tools.</p>
        <%= button_to "Delete All Attendance", admin_clear_attendance_path, method: :post, class: "btn btn-outline-danger align-self-start", data: { turbo_confirm: "Delete every attendance record? This cannot be undone." } %>
      </div>
    </div>
  <% end %>
</div>
