<% content_for :title, "Admin" %>
<%= render "shared/page_heading", title: "Admin", description: "Manage students and keep track of each school day.", eyebrow: "SCHOOL OFFICE" %>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4">Check-ins</h2>
    <%= form_with url: admin_root_path, method: :get, class: "mb-3", data: { controller: "roster-filter", turbo_action: "advance", turbo_frame: "admin-checkin-results" } do %>
      <%= hidden_field_tag :student_q, @student_q %>
      <%= hidden_field_tag :show_hidden, "1" if @show_hidden %>
      <%= hidden_field_tag :focus, @focus, data: { roster_filter_target: "focus" } %>
      <div class="row g-2">
        <div class="col-12 col-md-4">
          <label class="visually-hidden" for="attendance_day">Day</label>
          <%= date_field_tag :day, @day, id: "attendance_day", class: "form-control", max: Date.current, data: { action: "change->roster-filter#submitNow" } %>
        </div>
        <div class="col-12 col-md-8">
          <label class="visually-hidden" for="attendance_q">Search check-ins</label>
          <%= text_field_tag :attendance_q, @attendance_q, id: "attendance_q", class: "form-control", placeholder: "Search check-ins by name", autocomplete: "off", data: { roster_filter_target: "query", action: "input->roster-filter#submit", autofocus: (@focus == "attendance_q" ? "true" : nil) } %>
        </div>
      </div>
    <% end %>

    <%= turbo_frame_tag "admin-checkin-results" do %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Student</th>
              <th>Grade</th>
              <th>Check in</th>
              <th>Check out</th>
              <th>Checked in by</th>
              <th>Checked out by</th>
            </tr>
          </thead>
          <tbody>
            <% if @attendances.empty? %>
              <tr><td colspan="6" class="text-body-secondary">No check-ins on this day.</td></tr>
            <% else %>
              <% @attendances.each do |visit| %>
                <tr>
                  <td><%= visit.student.full_name %></td>
                  <td><%= visit.student.grade_label %></td>
                  <td><%= clock(visit.checkin) %></td>
                  <td><%= visit.checkout ? clock(visit.checkout) : "—" %></td>
                  <td><%= visit.recorded_by.email %></td>
                  <td><%= visit.checkout_by.presence || "—" %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4">Students</h2>
    <p class="text-body-secondary">Removing a student hides them from check-in and check-out. Their records stay.</p>

    <%= render "admin/students/form", student: @student, filters: admin_filter_params %>

    <%= form_with url: admin_root_path, method: :get, class: "mb-3", data: { controller: "roster-filter", turbo_action: "advance" } do %>
      <%= hidden_field_tag :day, @day %>
      <%= hidden_field_tag :attendance_q, @attendance_q %>
      <%= hidden_field_tag :focus, @focus, data: { roster_filter_target: "focus" } %>
      <div class="row g-2 align-items-center">
        <div class="col-12 col-md-6">
          <label class="visually-hidden" for="student_q">Search students</label>
          <%= text_field_tag :student_q, @student_q, id: "student_q", class: "form-control", placeholder: "Search students", autocomplete: "off", data: { roster_filter_target: "query", action: "input->roster-filter#submit", autofocus: (@focus == "student_q" ? "true" : nil) } %>
        </div>
        <div class="col-12 col-md-auto">
          <div class="form-check mb-0">
            <%= check_box_tag :show_hidden, "1", @show_hidden, class: "form-check-input", id: "show_hidden", data: { action: "change->roster-filter#submitNow" } %>
            <%= label_tag :show_hidden, "Show removed", class: "form-check-label" %>
          </div>
        </div>
      </div>
    <% end %>

    <div id="student-results">
      <% if @student_q.blank? %>
        <p class="text-body-secondary mb-0">Type a student’s name above to find and manage their record.</p>
      <% else %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Grade</th>
                <th>Blackbaud ID</th>
                <th>Guardians</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if @students.empty? %>
                <tr><td colspan="5" class="text-body-secondary">No students match.</td></tr>
              <% else %>
                <% @students.each do |student| %>
                  <tr>
                    <td>
                      <%= student.full_name %>
                      <% if student.hidden? %>
                        <span class="badge text-bg-secondary">Removed</span>
                      <% end %>
                    </td>
                    <td><%= student.grade_label %></td>
                    <td><%= student.blackbaud_id %></td>
                    <td><%= student.guardian_list %></td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2">
                        <%= link_to "Edit", edit_admin_student_path(student, admin_filter_params), class: "btn btn-outline-primary btn-sm", aria: { label: "Edit #{student.full_name}" } %>
                        <% if student.hidden? %>
                          <%= button_to "Restore", admin_student_path(student), method: :patch,
                                params: { student: { hidden: false } }.merge(admin_filter_params),
                                class: "btn btn-outline-primary btn-sm",
                                form: { class: "m-0", data: { turbo_frame: "_top" } } %>
                        <% else %>
                          <%= button_to "Remove", admin_student_path(student), method: :patch,
                                params: { student: { hidden: true } }.merge(admin_filter_params),
                                class: "btn btn-outline-danger btn-sm",
                                form: { class: "m-0", data: { turbo_frame: "_top", turbo_confirm: "Remove #{student.full_name} from the check-in lists? Their records stay in the database." } } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>

