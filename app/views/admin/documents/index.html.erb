<% content_for :title, "Documents" %>
<%= render "shared/page_heading", title: "Documents", description: "Create and edit school documents.", eyebrow: "SCHOOL OFFICE" %>

<div class="d-flex gap-2 mb-3">
  <%= link_to "New document", new_admin_document_path, class: "btn btn-primary" %>
  <%= link_to "Back to Admin", admin_root_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card shadow-sm">
  <% if @documents.any? %>
    <div class="list-group list-group-flush">
      <% @documents.each do |document| %>
        <%= link_to admin_document_path(document), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" do %>
          <span class="fw-semibold"><%= document.title %></span>
          <span class="text-body-secondary small">Updated <%= document.updated_at.strftime("%b %-d, %Y") %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="card-body text-body-secondary">No documents yet. Create a document to get started.</div>
  <% end %>
</div>
