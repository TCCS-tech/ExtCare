<% content_for :title, "Students" %>
<nav class="student-breadcrumb" aria-label="Admin navigation">
  <%= link_to "Admin home", admin_root_path %>
  <span aria-hidden="true">/</span>
  <span aria-current="page">Students</span>
</nav>
<%= render "shared/page_heading", title: "Students", description: "Manage student records and guardian information.", eyebrow: "SCHOOL OFFICE" %>

<div class="student-workspace">
  <section class="student-search-panel" aria-labelledby="student-search-heading">
    <h2 id="student-search-heading" class="h4">Find a student</h2>
    <p class="text-body-secondary">Search to view or update student details, or <%= link_to "add", new_admin_student_path(admin_filter_params), aria: { label: "Add a new student" } %> a new student.</p>
    <%= form_with url: admin_students_path, method: :get, role: "search", data: { controller: "roster-filter", turbo_action: "advance" } do %>
      <%= hidden_field_tag :day, @day %>
      <%= hidden_field_tag :attendance_q, @attendance_q %>
      <%= hidden_field_tag :focus, @focus, data: { roster_filter_target: "focus" } %>
      <%= label_tag :student_q, "Student name", class: "form-label fw-semibold" %>
      <div class="student-search-inputs">
        <%= search_field_tag :student_q, @student_q, id: "student_q", class: "form-control form-control-lg", placeholder: "First or last name", autocomplete: "off", aria: { describedby: "student-search-hint" }, data: { roster_filter_target: "query", action: "input->roster-filter#submit", autofocus: (@focus == "student_q" ? "true" : nil) } %>
        <%= button_tag "Search", class: "btn btn-primary" %>
      </div>
      <p id="student-search-hint" class="form-text mt-2">You can search with just part of a name.</p>
      <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
        <div class="form-check mb-0">
          <%= check_box_tag :show_hidden, "1", @show_hidden, class: "form-check-input", id: "show_hidden", data: { action: "change->roster-filter#submitNow" } %>
          <%= label_tag :show_hidden, "Include removed students", class: "form-check-label" %>
        </div>
        <% if @student_q.present? %>
          <%= link_to "Clear search", admin_students_path(admin_filter_params.except(:student_q)), class: "small" %>
        <% end %>
      </div>
    <% end %>
  </section>

</div>

<section id="student-results" class="student-results" aria-label="Search results">
  <% if @student_q.blank? %>
    <div class="student-search-empty">
      <h2 class="h5">Find a student to get started</h2>
      <p class="text-body-secondary mb-0">Type a student’s name above to find and manage their record.</p>
    </div>
  <% elsif @students.empty? %>
    <div class="student-search-empty">
      <h2 class="h5">No students match “<%= @student_q %>”</h2>
      <p class="text-body-secondary mb-0">Try a different spelling or part of their name<%= @show_hidden ? "." : ", or include removed students." %></p>
      <p class="mt-3 mb-0">New to ExtendedCare? <%= link_to "Add a new student", new_admin_student_path(admin_filter_params) %></p>
    </div>
  <% else %>
    <div class="student-results-heading">
      <h2 class="h5 mb-0"><%= pluralize(@students.size, "student") %> found</h2>
      <span class="text-body-secondary small">Select Edit to update a record.</span>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Grade</th>
            <th scope="col">Blackbaud ID</th>
            <th scope="col">Guardians</th>
            <th scope="col">Flags</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <tr>
              <td>
                <%= student.full_name %>
                <% if student.hidden? %>
                  <span class="badge text-bg-secondary">Removed</span>
                <% end %>
              </td>
              <td><%= student.grade_label %></td>
              <td><%= student.blackbaud_id %></td>
              <td><%= student.guardian_list %></td>
              <td class="text-nowrap"><%= render "shared/student_flags", student: student %></td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-2">
                  <%= link_to "Edit", edit_admin_student_path(student, admin_filter_params), class: "btn btn-outline-primary btn-sm", aria: { label: "Edit #{student.full_name}" } %>
                  <% if student.hidden? %>
                    <%= button_to "Restore", admin_student_path(student), method: :patch,
                          params: { student: { hidden: false } }.merge(admin_filter_params),
                          class: "btn btn-outline-primary btn-sm",
                          form: { class: "m-0", data: { turbo_frame: "_top" } } %>
                  <% else %>
                    <%= button_to "Remove", admin_student_path(student), method: :patch,
                          params: { student: { hidden: true } }.merge(admin_filter_params),
                          class: "btn btn-outline-danger btn-sm",
                          form: { class: "m-0", data: { turbo_frame: "_top", turbo_confirm: "Remove #{student.full_name} from the check-in lists? Their records stay in the database." } } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="student-results-note">Removing a student hides them from check-in and check-out. Their records stay, and you can restore them anytime.</p>
  <% end %>
</section>
