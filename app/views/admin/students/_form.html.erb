<%# locals: (student:, filters:) %>
<% if student.errors.any? %>
  <div class="alert alert-danger"><%= student.errors.full_messages.to_sentence %></div>
<% end %>

<%= form_with model: student, url: student.persisted? ? admin_student_path(student) : admin_students_path, class: "mb-4" do |form| %>
  <% filters.each do |key, value| %>
    <%= hidden_field_tag key, value %>
  <% end %>
  <div class="row g-3">
    <div class="col-12 col-md-4">
      <%= form.label :first_name, "First name", class: "form-label" %>
      <%= form.text_field :first_name, class: "form-control", required: true, autocomplete: "off" %>
    </div>
    <div class="col-12 col-md-4">
      <%= form.label :last_name, "Last name", class: "form-label" %>
      <%= form.text_field :last_name, class: "form-control", required: true, autocomplete: "off" %>
    </div>
    <div class="col-6 col-md-2">
      <%= form.label :grade, class: "form-label" %>
      <%= form.select :grade, Student.grade_options, { include_blank: "Grade" }, class: "form-select", required: true %>
    </div>
    <div class="col-6 col-md-3">
      <%= form.label :blackbaud_id, "Blackbaud ID", class: "form-label" %>
      <%= form.text_field :blackbaud_id, class: "form-control", autocomplete: "off" %>
    </div>
    <div class="col-6 col-md-3">
      <%= form.label :student_id, "Student ID", class: "form-label" %>
      <%= form.text_field :student_id, class: "form-control", autocomplete: "off" %>
    </div>
    <div class="col-12">
      <%= form.label :guardian_list, "Guardians", class: "form-label" %>
      <%= form.text_field :guardian_list, class: "form-control", placeholder: "Names, separated by commas", autocomplete: "off" %>
    </div>
    <div class="col-12">
      <%= form.label :notes, class: "form-label" %>
      <%= form.text_area :notes, class: "form-control", rows: 4 %>
    </div>
    <div class="col-12">
      <div class="d-flex flex-wrap gap-3">
        <div class="form-check">
          <%= form.check_box :staff, class: "form-check-input" %>
          <%= form.label :staff, "Staff", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= form.check_box :prepaid_am, class: "form-check-input" %>
          <%= form.label :prepaid_am, "Prepaid AM", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= form.check_box :prepaid_pm, class: "form-check-input" %>
          <%= form.label :prepaid_pm, "Prepaid PM", class: "form-check-label" %>
        </div>
      </div>
    </div>
    <div class="col-12">
      <%= form.submit(student.persisted? ? "Save changes" : "Add student", class: "btn btn-primary") %>
      <%= link_to "Cancel", admin_students_path(filters), class: "btn btn-outline-secondary ms-2" %>
    </div>
  </div>
<% end %>
