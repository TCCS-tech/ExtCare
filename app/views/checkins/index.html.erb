<% content_for :title, "Check in" %>
<h1 class="h3 mb-3">Check in</h1>

<%= render "shared/day_toolbar", route: :checkins_path, day: @day, grade: @grade, query: @q, autofocus: true %>

<% if @students.empty? %>
  <p class="text-body-secondary">No students match.</p>
<% else %>
  <div class="list-group shadow-sm">
    <% @students.each do |student| %>
      <%= render "student",
            student: student,
            visits: @visits_by_student[student.id] || [],
            open_visit: @open_visits[student.id],
            here_yesterday: @yesterday_ids.include?(student.id),
            day: @day,
            grade: @grade,
            query: @q %>
    <% end %>
  </div>
<% end %>
